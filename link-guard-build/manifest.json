{
  "manifest_version": 3,
  "name": "AegisScan - Protection des liens",
  "version": "1.0.0",
  "description": "Protection automatique contre les liens malveillants par AegisScan",

  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup.html", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "AegisScan Protection",
    "default_icon": "icons/icon48.png"
  }
}

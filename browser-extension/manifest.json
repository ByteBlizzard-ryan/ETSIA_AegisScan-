{
  "manifest_version": 3,
  "name": "AegisScan Link Protection",
  "version": "1.0.0",
  "description": "Protection automatique contre les liens malveillants",
  
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "tabs",
    "nativeMessaging"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "AegisScan Protection"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}